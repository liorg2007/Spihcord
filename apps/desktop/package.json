{
  "name": "@shpihcord/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shpihcord desktop client",
  "author": "Shpihcord",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@shpihcord/call-engine": "*",
    "@shpihcord/protocol": "*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.4.4",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "vite": "^5.4.0",
    "zustand": "^5.0.0"
  },
  "homepage": "https://github.com/liorg2007/Spihcord",
  "repository": {
    "type": "git",
    "url": "https://github.com/liorg2007/Spihcord.git"
  }
}
