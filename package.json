{
  "name": "shpihcord",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:hub": "npm run dev -w @shpihcord/hub",
    "dev:desktop": "npm run dev -w @shpihcord/desktop",
    "test:e2e": "vite build --config tests/e2e/vite.config.ts && electron tests/e2e/main.cjs",
    "hub": "npm run start -w @shpihcord/hub",
    "hub:invite": "npm run create-invite -w @shpihcord/hub --",
    "dist": "npm run dist -w @shpihcord/desktop"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
