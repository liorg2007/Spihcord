# Public hostname pointing at this machine (A/AAAA record). Caddy gets a TLS cert for it.
DOMAIN=chat.example.com

# Shared secret between the hub and coturn. Generate with:  openssl rand -hex 32
# The hub REFUSES TO START with this placeholder or anything under 32 characters.
TURN_SECRET=change-me

# Optional overrides
# HUB_TAG=latest            # hub image tag on ghcr.io (e.g. 0.2.0)
# TURN_TTL_SECONDS=14400     # TURN credential lifetime (4 h, refreshed automatically)
# TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp,turns:chat.example.com:5349?transport=tcp
# WS_MAX_CONNECTIONS=1000     # WebSocket caps (unauthenticated sockets count too)
# WS_MAX_CONNECTIONS_PER_IP=20
# WS_MAX_PENDING=100
# STUN_URLS=stun:stun.l.google.com:19302
# LOG_LEVEL=info
