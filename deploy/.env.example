# Public hostname pointing at this machine (A/AAAA record). Caddy gets a TLS cert for it.
DOMAIN=chat.example.com

# Shared secret between the hub and coturn. Generate with:  openssl rand -hex 32
TURN_SECRET=change-me

# Optional overrides
# TURN_TTL_SECONDS=43200
# STUN_URLS=stun:stun.l.google.com:19302
# LOG_LEVEL=info
